	.sect code,MyInitUSBDescriptors	// 23 words
	.export _MyInitUSBDescriptors
_MyInitUSBDescriptors:
	ldx (I6)+1,NULL	// I6 += 1
	stx LR0,(I6)+1
	stx I6,(I6) ; sty I4,(I6)
	ldx (I6)+1,I4
	stx A0,(I6)+1 ; sty I0,(I6)
	sub NULL,ONES,A0	// 1 -> 1 -> ET0
//   RealInitUSBDescriptors (1);
	call _RealInitUSBDescriptors
	stx A0,(I6)	// ET0
// jumped away
	ldc _myVendorNameStr,A0	// ET1
	ldc _USB+1,I0	// ET4
	stx A0,(I0)+1 ; ldy (I6)-1,NULL	// I6 += -1
//   USB.descriptorTable[1] = myVendorNameStr;
//   USB.descriptorTable[2] = myModelNameStr;
	ldc _myModelNameStr,A0	// ET5
	stx A0,(I0)+1	// ET5 ==> ET4
//   USB.descriptorTable[3] = mySerialNumberStr;
	ldc _mySerialNumberStr,A0	// ET8
	stx A0,(I0)+1	// ET8 ==> ET4
//   USB.descriptorTable[4] = myDeviceDescriptor;
	ldc _myDeviceDescriptor,A0	// ETb
	stx A0,(I0) ; ldy (I6),I0	// ETb ==> ET4
	ldx (I6)-1,A0
	ldx (I4),I6 ; ldy (I4),I4
	ldx (I6)-1,NULL	// I6 += -1
	ldx (I6)-1,LR0
	jr
	nop
// jumped away

