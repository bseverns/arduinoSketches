	.sect code,SingleCycleCommand	// 21 words
	.export _SingleCycleCommand
_SingleCycleCommand:
	ldx (I6)+1,NULL	// I6 += 1
	stx LR0,(I6)+1
	stx I6,(I6) ; sty I4,(I6)
	ldx (I6)+1,I4
	stx A0,(I6) ; sty A1,(I6)+1
	ldc 46,A0	// 46 -> 1 -> ET2
	ldc 47,A1	// 47 -> 1 -> ET0
	stx I0,(I6)+1 ; ldy (I4)-2,NULL
	ldc 49256,I0	// 49256 -> ET1
// (*(__x volatile u_int16 *)(u_int16)(0xC068)) =(1<<5) |(7<<1) |(1<<0);
	stx A1,(I0)/*V*/	// ET0 ==> ET1
// (*(__x volatile u_int16 *)(u_int16)(0xC068)) =(1<<5) |(7<<1) |(0<<0);
	stx A0,(I0)/*V*/	// ET2 ==> ET1
//   SpiSendReceive (cmd);
	call _SpiSendReceive
	ldx (I4)+2,A0	// unspill 'cmd' from #0
// jumped away
// (*(__x volatile u_int16 *)(u_int16)(0xC068)) =(1<<5) |(7<<1) |(1<<0);
	stx A1,(I0)/*V*/	// ET0 ==> ET1
	ldx (I6)-1,I0
	ldy (I6),A1 ; ldx (I6)-1,A0
	ldx (I4),I6 ; ldy (I4),I4
	ldx (I6)-1,NULL	// I6 += -1
	ldx (I6)-1,LR0
	jr
	nop
// jumped away

